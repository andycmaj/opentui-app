{
  "name": "@andycmaj/opentui-app",
  "version": "0.1.0",
  "description": "App framework + design library for @opentui/solid terminal UIs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andycmaj/opentui-app.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./boot": "./src/boot/index.ts",
    "./keyboard": "./src/keyboard/index.ts",
    "./theme": "./src/theme/index.ts",
    "./context": "./src/context/index.ts",
    "./data": "./src/data/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "version:bump": "bun run script/version.ts"
  },
  "peerDependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "solid-js": "1.9.12"
  },
  "dependencies": {
    "@opentui/keymap": "0.5.12",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "solid-js": "1.9.12"
  }
}
