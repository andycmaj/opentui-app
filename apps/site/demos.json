{
  "$comment": "Recorded demos. `repo` is checked out next to this repo (or passed with --path id=dir); `keys` is relative to that checkout. Recorded by scripts/record-all.ts.",
  "demos": [
    {
      "id": "tilt-tui",
      "repo": "andycmaj/tilt-tui",
      "keys": "demo/demo.keys",
      "env": { "TILT_TUI_FIXTURE": "default" }
    },
    {
      "id": "ghdash",
      "repo": "andycmaj/ghdash",
      "keys": "demo/demo.keys",
      "env": { "GHDASH_FIXTURE": "default" }
    },
    {
      "id": "kube-tui",
      "repo": "andycmaj/kube-tui",
      "keys": "demo/demo.keys",
      "env": { "KUBE_TUI_FIXTURE": "default" }
    },
    {
      "id": "keymaps",
      "repo": "andycmaj/opentui-app",
      "cwd": "apps/example",
      "keys": "apps/example/demo/keymaps.keys",
      "args": ["keymaps"]
    }
  ]
}
