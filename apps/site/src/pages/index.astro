---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Pane from "../components/Pane.astro";
import PaneHeader from "../components/PaneHeader.astro";
import Card from "../components/Card.astro";
import StatusBadge from "../components/StatusBadge.astro";
import KeyHints from "../components/KeyHints.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const apps = (await getCollection("apps")).sort((a, b) => a.data.order - b.data.order);
const first = apps[0]?.data.name ?? "";
---

<Base section="apps">
  <Pane focused class="hero" aria-label="Demo">
    <PaneHeader title={first} level={1}>
      <KeyHints hints={[{ keys: "←/→", text: "switch app" }]} />
    </PaneHeader>
    <div class="screen">recording goes here</div>
  </Pane>

  <section id="apps" class="gallery" aria-label="Apps" data-nav-list>
    <Card href={`${base}/framework/`} selected accent="var(--secondary)">
      <Fragment slot="header">
        <strong class="name">@andycmaj/opentui-app</strong>
        <span class="muted">framework</span>
      </Fragment>
      <p>The engine all of these are built on.</p>
    </Card>
    {
      apps.map((app) => (
        <Card href={`${base}/apps/${app.id}/`}>
          <Fragment slot="header">
            <strong class="name">{app.data.name}</strong>
            <StatusBadge status={app.data.status} />
          </Fragment>
          <p>{app.data.pitch}</p>
        </Card>
      ))
    }
  </section>
</Base>

<style>
  .screen {
    display: grid;
    place-items: center;
    aspect-ratio: 120 / 36;
    max-width: 100%;
    background: var(--pane);
    color: var(--muted);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 34ch), 1fr));
    gap: var(--row) var(--cell);
    margin-top: var(--row);
    padding: 0 calc(var(--cell) * 2);
  }
  .name {
    color: var(--primary);
  }
  .gallery p {
    margin: 0;
    font-family: var(--sans);
  }
</style>
