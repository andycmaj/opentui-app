---
import Base from "../layouts/Base.astro";
import Pane from "../components/Pane.astro";
import PaneHeader from "../components/PaneHeader.astro";
import { fetchReleases } from "../lib/releases";

const releases = await fetchReleases();
---

<Base title="changelog" description="Releases of @andycmaj/opentui-app." section="changelog">
  <Pane as="article">
    <PaneHeader title="changelog" level={1}>
      <a href="https://github.com/andycmaj/opentui-app/releases">all releases</a>
    </PaneHeader>
    {releases.length === 0 && <p class="muted">Release notes could not be loaded.</p>}
    <ol class="releases">
      {
        releases.map((release) => (
          <li>
            <h2 id={release.tag}>
              <a href={release.url}>{release.name}</a>
              <span class="muted date">{release.date}</span>
            </h2>
            <div class="prose" set:html={release.html} />
          </li>
        ))
      }
    </ol>
  </Pane>
</Base>

<style>
  .releases {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--content-w);
  }
  .releases h2::before {
    content: none;
  }
  .releases h2 {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
    align-items: baseline;
  }
  .releases h2 a {
    color: var(--primary);
  }
  .date {
    font-weight: 400;
    font-size: 0.9rem;
  }
</style>
